<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">#25353C</item>
        <item name="android:textColorSecondary">#5D6E75</item>
        <item name="android:colorControlNormal">#5D6E75</item>
        <item name="android:colorAccent">#285F5A</item>
        <item name="android:popupMenuStyle">@style/RollmarkPopup</item>
        <item name="android:alertDialogTheme">@style/RollmarkDialogTheme</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#E9EEF0</item>
        <item name="android:navigationBarColor">#E9EEF0</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#E9EEF0</item>
    </style>
    <style name="RollmarkDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">#25353C</item>
        <item name="android:textColorSecondary">#5D6E75</item>
        <item name="android:colorControlNormal">#5D6E75</item>
        <item name="android:colorAccent">#285F5A</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:buttonBarButtonStyle">@style/RollmarkDialogButton</item>
    </style>
    <style name="RollmarkDialogButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="RollmarkPopup" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_dialog</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase"/>
</resources>
